{
  "name": "moments",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w server && npm run build -w web",
    "start": "node server/dist/index.js",
    "test": "npm run test -w server && npm run test -w web",
    "test:server": "npm run test -w server",
    "test:web": "npm run test -w web",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@12.11.1": true
  }
}
