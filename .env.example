# ===== 服务 =====
PORT=8787
HOST=0.0.0.0
DATA_DIR=./data
# 生产环境务必改成 64 位随机字符串： openssl rand -hex 32
JWT_SECRET=dev-secret-please-change-me
# 关闭注册入口（给朋友开放阶段可控）：false
REGISTER_ENABLED=true
MAX_PHOTOS_PER_SESSION=30
MAX_FILE_MB=30
# 反代/应用的上传 body 上限（字节），需 >= 30张 x 30MB
UPLOAD_BODY_LIMIT=125829120
# 全局模型并发闸（所有用户共享，防止打爆供应商限流）
MODEL_CONCURRENCY=4

# ===== 模型供应商（至少配一个 Key 才有真实分析能力；不配时可用 mock 调试全流程）=====
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODELS=glm-4.5v,glm-4v-plus

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-4o-mini,gpt-4o

# 自定义 OpenAI 兼容端点（可选）
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_LABEL=
CUSTOM_MODEL=
CUSTOM_MODELS=

# ===== 部署（docker-compose + Caddy 自动 HTTPS）=====
DOMAIN=moments.example.com
